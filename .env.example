# Copy to `.env` and fill in. `.env` is gitignored; this file is the committed
# template, so it must never hold a real value. Every key is read server-side
# only — see CLAUDE.md, "Secrets never reach the frontend".

# LLM provider for the agent (Phase 1a onward).
OPENAI_API_KEY=

# Tavily API key
TAVILY_API_KEY=

# CMS Marketplace API key (Phase 3 structured-API lane). Optional: without it the
# reference, relational, and web lanes still work. Request your own at
# https://developer.cms.gov/marketplace-api/key-request.html — note the key expires
# every 60 days, and a replacement is emailed automatically.
#
# To develop before your key arrives: CMS publishes a shared, rate-limited demo key in
# the Quickstart section of https://developer.cms.gov/marketplace-api/api-spec — copy it
# from there. It is fine for hand-run calls and for recording fixtures; it is NOT yours,
# so never run evals or sustained loops against it, and never commit it.
CMS_MARKETPLACE_API_KEY=

# openFDA API key. OPTIONAL — the FDA tools work without it, at 1,000 requests/day per IP; a key
# raises that to 120,000/day. Free and instant from https://open.fda.gov/apis/authentication/
# (which signs up through https://api.data.gov/signup/).
#
# This repo originally declined the key on the reasoning that per-drug lookups never approach the
# keyless ceiling. That is still true of a hand-run question, and NOT true of an eval sweep, whose
# worst case is ~78% of a single day's per-IP allowance. See docs/structured-api-tools.md §4a.
OPENFDA_API_KEY=
