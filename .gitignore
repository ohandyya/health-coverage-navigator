# Python-generated files
__pycache__/
*.py[cod]
build/
dist/
wheels/
*.egg-info
.eggs/

# Virtual environments
.venv
env/
venv/

# Secrets / environment config (Marketplace API key, etc. — see plan.md)
.env
.env.*
!.env.example

